# Copier ce fichier en .env (même dossier) et remplir les valeurs. Ne jamais committer .env.
# Supabase : Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé service_role (jamais dans le frontend, un log ou git)
SUPABASE_KEY=

# Actualités (optionnel si seuls les flux RSS sont utilisés)
NEWS_API_KEY=

# Origines autorisées par CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173

# Seuils de conseil (facultatif). Par défaut ceux de la SPEC : 60 / 40. Essai en ligne : 55 / 45 (D-10).
# Laisser commenté pour lancer les tests (les cas V9 et V10 vérifient les seuils de la SPEC).
# SEUIL_ACHAT=60
# SEUIL_VENTE=40
